# PostgreSQL: credenciales separadas para que cada componente sea visible.
# Ajusta estos valores a tu instalación local.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=helpdesk
DB_USER=postgres
DB_PASSWORD=postgres

# Clave usada para firmar y validar JWT.
# En un proyecto real debe ser larga, aleatoria y mantenerse fuera del repositorio.
JWT_SECRET=change-this-development-secret

# Puerto HTTP de Express.
PORT=3000

# Opcional: URL que usará el CLI para consumir la API.
# Si se omite, el CLI usa http://localhost:<PORT>.
# API_URL=http://localhost:3000

# ================================================================
# RAILWAY — REFERENCIA DE CONFIGURACIÓN
# ================================================================
#
# El proyecto básico puede desplegarse SIN modificar JavaScript.
# Local y Railway usan los mismos nombres de variables; cambian sus valores.
#
# En el servicio `helpdesk` de Railway:
#
# DB_HOST=${{Postgres.PGHOST}}
# DB_PORT=${{Postgres.PGPORT}}
# DB_NAME=${{Postgres.PGDATABASE}}
# DB_USER=${{Postgres.PGUSER}}
# DB_PASSWORD=${{Postgres.PGPASSWORD}}
#
# EJEMPLO PÚBLICO DE FORMATO PARA JWT_SECRET:
# JWT_SECRET=ea11e52d713c289855b0f62fe1846b2e5069417614f817a2b87352c0241221dcc9a9fea59bc49bf5e23ad8c67d10cd94
#
# IMPORTANTE:
# Ese valor aparece en un archivo versionado, por lo tanto NO debe usarse
# como secreto real de producción. En Railway genera y guarda otro valor.
#
# NO es necesario definir PORT manualmente:
# Railway inyecta PORT y src/config/env.js ya lee process.env.PORT.
#
# UPLOADS:
# El código actual escribe en ./uploads.
# Si necesitamos persistencia y podemos crear otro Volume en Railway,
# podemos montarlo en:
#
# /app/uploads
#
# No definir UPLOAD_DIR aquí: el proyecto actual NO lee esa variable.
# UPLOAD_DIR solo tendría sentido después de un refactor explícito del código.

