<section class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="card-body p-0">
    <div class="d-flex justify-content-between align-items-center p-4 pb-3">
      <div>
        <p class="text-uppercase small fw-semibold text-body-secondary mb-1">Tu bandeja</p>
        <h2 class="h5 mb-0">Tickets actuales</h2>
      </div>
      <span class="badge text-bg-secondary rounded-pill">Resumen de tickets</span>
    </div>

    <div class="table-responsive">
      <table class="table table-hover table-striped align-middle mb-0">
        <thead>
          <tr>
            <th class="ps-4">ID</th>
            <th>Título</th>
            <th>Estado</th>
            <th>Prioridad</th>
            <th>Avance</th>
            <th>Responsable</th>
            <th class="pe-4">Acciones</th>
          </tr>
        </thead>

        {{!--
          Handlebars entrega la estructura de la tabla, pero el tbody se
          completa en el navegador con datos obtenidos mediante fetch().
        --}}
        <tbody id="ticket-table-body" class="table-group-divider"></tbody>
      </table>
    </div>
  </div>
</section>
