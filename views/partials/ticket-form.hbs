<section class="card shadow-sm border-0 rounded-4 overflow-hidden">
  <div class="card-body p-4">
    <div class="d-flex justify-content-between align-items-center gap-2 mb-4">
      <div>
        <p class="text-uppercase small fw-semibold text-body-secondary mb-1">Datos de la solicitud</p>
        <h2 id="form-title" class="h5 mb-0">Crear ticket</h2>
      </div>
      <span class="badge text-bg-primary rounded-pill">Crear / Editar</span>
    </div>

    {{!--
      El mismo formulario sirve para CREATE y UPDATE.
      ticket-id permanece vacío en modo creación y contiene un id al editar.
    --}}
    <form id="ticket-form" class="vstack gap-3">
      <input id="ticket-id" type="hidden">

      <div class="form-floating">
        <input
          id="title"
          class="form-control"
          placeholder="Título"
          maxlength="150"
          required
        >
        <label for="title">Título</label>
      </div>

      <div>
        <label for="description" class="form-label">Descripción</label>
        <textarea
          id="description"
          class="form-control"
          rows="4"
          placeholder="Describe el problema"
        ></textarea>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <div class="form-floating">
            <select id="status" class="form-select" aria-label="Estado">
              <option value="open">Abierto</option>
              <option value="in_progress">En progreso</option>
              <option value="closed">Cerrado</option>
            </select>
            <label for="status">Estado</label>
          </div>
        </div>

        <div class="col-md-6">
          <div class="form-floating">
            <input
              id="priority"
              type="number"
              min="1"
              max="5"
              value="3"
              class="form-control"
              placeholder="Prioridad"
            >
            <label for="priority">Prioridad</label>
          </div>
        </div>
      </div>

      <div class="row g-3">
        <div class="col-md-6">
          <div class="form-floating">
            <input
              id="estimated-hours"
              type="number"
              min="0"
              step="0.5"
              class="form-control"
              placeholder="Horas estimadas"
            >
            <label for="estimated-hours">Horas estimadas</label>
          </div>
        </div>

        <div class="col-md-6">
          <label for="progress" class="form-label small text-body-secondary">Avance</label>
          <div class="input-group">
            <input
              id="progress"
              type="number"
              min="0"
              max="100"
              value="0"
              class="form-control"
              aria-label="Porcentaje de avance"
            >
            <span class="input-group-text">%</span>
          </div>
        </div>
      </div>

      <div class="form-floating">
        <input id="due-date" type="date" class="form-control" placeholder="Fecha límite">
        <label for="due-date">Fecha límite</label>
      </div>

      <div class="form-check form-switch bg-body-tertiary border rounded-3 p-3 ps-5">
        <input id="urgent" class="form-check-input" type="checkbox" role="switch">
        <label for="urgent" class="form-check-label fw-semibold">Ticket urgente</label>
      </div>

      <div class="d-grid d-sm-flex gap-2 pt-1">
        <button class="btn btn-primary flex-grow-1" type="submit">Guardar ticket</button>
        <button
          id="cancel-edit"
          class="btn btn-outline-secondary d-none"
          type="button"
        >
          Cancelar edición
        </button>
      </div>
    </form>
  </div>
</section>
